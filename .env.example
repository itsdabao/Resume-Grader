# Force provider selection
# LLM_PROVIDER=groq | openai_compat | llama_cpp | gemini | openai | none
LLM_PROVIDER=groq

# --- Runtime environment ---
# APP_ENV=dev | production
APP_ENV=dev

# --- API security ---
# Comma-separated origins. In production you should set this explicitly.
# CORS_ALLOW_ORIGINS=https://your-app.com,https://admin.your-app.com
CORS_ALLOW_ORIGINS=
CORS_ALLOW_CREDENTIALS=1

# Require owner auth for /admin/api/* (default true in production)
ADMIN_REQUIRE_OWNER_AUTH=0

# Public /query endpoint control
# Set to 0 in production to force authenticated chat (/chat) or x-api-key.
ENABLE_PUBLIC_QUERY_ENDPOINT=1
PUBLIC_QUERY_API_KEY=

# --- Rate limit ---
RATE_LIMIT_ENABLED=1
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_QUERY_MAX=30
RATE_LIMIT_CHAT_MAX=60
RATE_LIMIT_WS_MAX=30

# --- Auth / tenant policy ---
ALLOW_UID_AS_TENANT_FALLBACK=1
REQUIRE_TENANT_ID=0
ENFORCE_METADATA_FILTERS=1

# --- LLM Providers Configs ---

# 1. Groq (OpenAI-compatible)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 2. Google Gemini Fallback
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=models/gemma-4-31b-it
GEMINI_MODEL_FALLBACK=gemini-1.5-flash
GEMINI_VISION_MODEL=gemini-3.5-flash

# 3. Local/Remote OpenAI-compatible
# OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1
# OPENAI_COMPAT_MODEL=local-model
# OPENAI_COMPAT_API_KEY=local

# 4. llama-cpp-python (in-process GGUF)
# LLAMA_CPP_MODEL_PATH=models/qwen2.5-3b-instruct-q4_k_m.gguf
# LLAMA_CPP_N_GPU_LAYERS=-1
# LLAMA_CPP_N_CTX=2048
# LLAMA_CPP_CHAT_FORMAT=chatml
# LLAMA_CPP_N_THREADS=0
# LLAMA_CPP_TEMPERATURE=0.2
# LLAMA_CPP_MAX_TOKENS=1024
# LLAMA_CPP_VERBOSE=0

# 5. OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# --- Databases & Memory ---
# SQLite (quick local dev):
DATABASE_URL=sqlite:///./agent_local.db
# PostgreSQL (for production):
# DATABASE_URL=postgresql+psycopg2://admin:password@localhost:5432/agent_memory

CHAT_SESSIONS_TABLE=chat_sessions

# Memory controls (apply to rolling_summary + last N turns)
MEMORY_ENABLED=1
MEMORY_LAST_TURNS=6
MEMORY_BUDGET_TOKENS=1000
MEMORY_SUMMARY_ENABLED=1
MEMORY_SUMMARY_MAX_OUTPUT_TOKENS=350

# Prompt history (non-DB fallback history list)
HISTORY_MAX_TURNS=12

# --- Firebase (protected /chat endpoint) ---
# Path to Firebase Admin SDK service account JSON.
FIREBASE_SERVICE_ACCOUNT_PATH=service_account.json

# --- Owner Console ---
OWNER_USERNAME=owner
OWNER_PASSWORD=change_me_to_strong_password
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_MIN=1440

# --- Debug ---
DEBUG_VERBOSE=0
DEBUG_SHOW_PROMPT=0
DEBUG_TOPN_PRINT=3
